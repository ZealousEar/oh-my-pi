#!/usr/bin/python3
"""omp-secret: the one place credential-marked settings are written for ALL omp channels.

  omp-secret set <key> [value]      value from arg, or prompted (hidden) when omitted; "-" reads stdin
  omp-secret unset <key>
  omp-secret get <key>              presence + sha256[:12] fingerprint only (never the value)
  omp-secret list                   keys present in the shared overlay
  omp-secret keys                   credential-marked keys this tool manages
  omp-secret sync [--quiet]         move profile-local copies (stock/daily-fork/dev-fork config.yml) into the overlay

The overlay (~/.omp-channels/shared/credential-settings.yml, 0600) is the last PI_CONFIG_FILES entry of
every channel launcher, so a key set here is the effective value in omp, ompd and ompdev. The fork
channels route `config set`/`/settings` writes of these keys here in-process (OMP_SHARED_SECRETS_FILE);
the immutable stock channel routes `config set|reset` through its launcher and `sync` catches the
settings-panel path. Values must be strings; `images.urls.credentials` (a record) is managed by hand.
"""
import getpass, hashlib, json, os, re, sys, tempfile, time

HOME = os.path.expanduser("~")
OVERLAY = f"{HOME}/.omp-channels/shared/credential-settings.yml"
KEYS_FILE = "/Users/farhad/.omp/implementation-2026-09-18/launchers/profile-seed/credential-keys.txt"
PROFILES = ("stock", "daily-fork", "dev-fork")
HEADER = """# Shared credential-marked settings (written by omp; hand-edits are preserved on the next write).
# This file is the second PI_CONFIG_FILES overlay of every omp channel launcher: a key here is the
# effective value in omp, ompd and ompdev. Keep it 0600.
"""

def keys():
    return [l.strip() for l in open(KEYS_FILE) if l.strip() and not l.startswith("#")]

def yaml_quote(v: str) -> str:
    return json.dumps(v)  # JSON string literal is valid YAML double-quoted scalar

def parse_scalar(raw: str):
    raw = raw.strip()
    if raw.startswith('"'): return json.loads(raw)
    if raw.startswith("'"): return raw[1:-1].replace("''", "'")
    if raw.startswith("#") or raw == "": return None
    return raw.split(" #")[0].strip()

def read_tree(path):
    """Minimal reader for nested mappings of scalar strings (the shape omp writes for these keys)."""
    tree = {}
    if not os.path.exists(path): return tree
    stack = [(-1, tree)]
    for line in open(path, encoding="utf-8"):
        if not line.strip() or line.lstrip().startswith("#"): continue
        indent = len(line) - len(line.lstrip(" "))
        body = line.strip()
        while stack and stack[-1][0] >= indent: stack.pop()
        parent = stack[-1][1]
        if ":" not in body: continue
        k, _, rest = body.partition(":")
        k = k.strip().strip('"')
        if rest.strip() == "":
            child = {}; parent[k] = child; stack.append((indent, child))
        else:
            parent[k] = parse_scalar(rest)
    return tree

def get_path(tree, dotted):
    cur = tree
    for seg in dotted.split("."):
        if not isinstance(cur, dict) or seg not in cur: return None
        cur = cur[seg]
    return cur

def set_path(tree, dotted, value):
    segs = dotted.split("."); cur = tree
    for seg in segs[:-1]:
        if not isinstance(cur.get(seg), dict): cur[seg] = {}
        cur = cur[seg]
    if value is None: cur.pop(segs[-1], None)
    else: cur[segs[-1]] = value
    # prune empties
    def prune(d):
        for k in list(d):
            if isinstance(d[k], dict):
                prune(d[k])
                if not d[k]: del d[k]
    prune(tree)

def dump(tree, indent=0):
    out = []
    for k, v in tree.items():
        pad = "  " * indent
        if isinstance(v, dict):
            out.append(f"{pad}{k}:"); out.append(dump(v, indent + 1))
        else:
            out.append(f"{pad}{k}: {yaml_quote(str(v))}")
    return "\n".join(o for o in out if o != "")

def write_tree(path, tree):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    body = dump(tree)
    fd, tmp = tempfile.mkstemp(prefix=".credential-settings.", dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f: f.write(HEADER + (body + "\n" if body else ""))
    os.chmod(tmp, 0o600); os.replace(tmp, path)

def fp(v: str) -> str: return hashlib.sha256(v.encode()).hexdigest()[:12]

def require_key(key):
    if key not in keys():
        print(f"omp-secret: '{key}' is not a credential-marked setting; managed keys: {', '.join(keys())}", file=sys.stderr); sys.exit(64)
    if key == "images.urls.credentials":
        print("omp-secret: images.urls.credentials is a record; edit the overlay by hand", file=sys.stderr); sys.exit(64)

def remove_from_profile(cfg_path, key):
    """Surgically drop `key` (a.b or a.b.c) from a profile config.yml without reformatting other lines."""
    if not os.path.exists(cfg_path): return None
    lines = open(cfg_path, encoding="utf-8").read().split("\n")
    segs = key.split("."); value = None
    # locate chain by indentation
    idx = 0; depth_indent = -1; found_chain = []
    for target in segs:
        hit = None
        for i in range(idx, len(lines)):
            l = lines[i]
            if not l.strip() or l.lstrip().startswith("#"): continue
            ind = len(l) - len(l.lstrip(" "))
            if ind <= depth_indent and found_chain: break
            body = l.strip()
            if ind == depth_indent + (2 if found_chain else 0) or (not found_chain and ind == 0):
                k = body.split(":", 1)[0].strip().strip('"')
                if k == target:
                    hit = i; break
        if hit is None: return None
        found_chain.append(hit); depth_indent = len(lines[hit]) - len(lines[hit].lstrip(" ")); idx = hit + 1
    leaf = found_chain[-1]
    value = parse_scalar(lines[leaf].split(":", 1)[1])
    del lines[leaf]
    # remove now-empty parents (a parent is empty when the next non-blank line is not deeper than it)
    for pi in reversed(found_chain[:-1]):
        pind = len(lines[pi]) - len(lines[pi].lstrip(" "))
        nxt = next((l for l in lines[pi + 1:] if l.strip() and not l.lstrip().startswith("#")), "")
        if nxt == "" or (len(nxt) - len(nxt.lstrip(" "))) <= pind: del lines[pi]
        else: break
    bak = f"{cfg_path}.bak-secret-sync-{time.strftime('%Y%m%dT%H%M%S')}"
    os.replace(cfg_path, bak); os.chmod(bak, 0o600)
    with open(cfg_path, "w", encoding="utf-8") as f: f.write("\n".join(lines))
    os.chmod(cfg_path, 0o600)
    return value

def cmd_sync(quiet):
    tree = read_tree(OVERLAY); moved = []
    for prof in PROFILES:
        cfg = f"{HOME}/.omp/profiles/{prof}/agent/config.yml"
        present = read_tree(cfg)
        for key in keys():
            if key == "images.urls.credentials": continue
            v = get_path(present, key)
            if isinstance(v, str) and v != "":
                val = remove_from_profile(cfg, key)
                if val is not None:
                    set_path(tree, key, val); moved.append((prof, key, fp(val)))
    if moved: write_tree(OVERLAY, tree)
    if not quiet or moved:
        for prof, key, f in moved: print(f"omp-secret: moved {key} from profile {prof} into the shared overlay (fp {f})")
        if not moved and not quiet: print("omp-secret: nothing to sync")
    return 0

def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"): print(__doc__); return 0
    cmd = a[0]
    if cmd == "keys": print("\n".join(keys())); return 0
    if cmd == "list":
        tree = read_tree(OVERLAY)
        for key in keys():
            v = get_path(tree, key)
            if isinstance(v, str): print(f"{key}  (set, fp {fp(v)}, {len(v)} chars)")
        return 0
    if cmd == "sync": return cmd_sync("--quiet" in a)
    if cmd in ("set", "unset", "get"):
        if len(a) < 2: print(__doc__, file=sys.stderr); return 64
        key = a[1]; require_key(key)
        tree = read_tree(OVERLAY)
        if cmd == "get":
            v = get_path(tree, key)
            print(f"{key}: {'set, fp ' + fp(v) + ', ' + str(len(v)) + ' chars' if isinstance(v, str) else 'not set'}"); return 0
        if cmd == "unset":
            set_path(tree, key, None); write_tree(OVERLAY, tree); cmd_sync(True); print(f"omp-secret: unset {key} (shared)"); return 0
        if len(a) >= 3: value = sys.stdin.read().rstrip("\n") if a[2] == "-" else a[2]
        else: value = getpass.getpass(f"{key}: ")
        if value == "": print("omp-secret: empty value; use unset", file=sys.stderr); return 64
        set_path(tree, key, value); write_tree(OVERLAY, tree); cmd_sync(True)
        print(f"omp-secret: set {key} (shared, fp {fp(value)}); effective in omp, ompd and ompdev"); return 0
    print(__doc__, file=sys.stderr); return 64

if __name__ == "__main__":
    sys.exit(main())
