<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily commit + push of the omp profile layer. Installed by launchers/install.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.omp.profile-layer-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/farhad/.omp/profile-layer/sync/profile-sync.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>20</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/farhad/.omp/profile-layer-sync/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/farhad/.omp/profile-layer-sync/launchd.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
